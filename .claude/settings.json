{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/skillEnforcement/skillGate.mjs\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking required skills"
          }
        ]
      }
    ]
  }
}
