<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+). Without this, launchers fall back to the
  legacy mipmap-*/ic_launcher.png and box it inside their own plate.

  NOTE: the background is @color/iconBackground, NOT @drawable/ic_launcher_background
  — that file is misnamed and actually holds the splash layer-list, so pointing
  at it would render the splash logo inside the app icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/iconBackground" />
  <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
