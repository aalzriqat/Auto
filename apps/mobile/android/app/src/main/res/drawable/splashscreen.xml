<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash window background. The logo must be a CENTERED layer, not the raw
  bitmap: a PNG referenced straight from android:windowBackground is drawn with
  FILL gravity and gets stretched to the whole portrait window, distorting the
  AutoFlow logo. The white plate comes from @color/splashscreen_background, so
  splashscreen_logo.png itself is transparent.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@color/splashscreen_background" />
  <item>
    <bitmap
      android:gravity="center"
      android:src="@drawable/splashscreen_logo" />
  </item>
</layer-list>
