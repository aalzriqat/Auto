{
  "id": "accountant-backfill-leaves-an-owner-restricted-accountant-alone",
  "domain": "permission",
  "level": "backend",
  "status": "active",
  "source": {
    "runId": "scrum896-round4",
    "hunter": "scripted",
    "firstSeen": "2026-11-02"
  },
  "steps": [
    {
      "actor": {
        "role": "internal",
        "org": "A"
      },
      "action": "migrateRoles.backfillAccountantCostPriceAccess",
      "input": {
        "role": "ACCOUNTANT_WITHOUT_COST_ACCESS"
      }
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.update",
      "input": {
        "role": "ACCOUNTANT",
        "removePermission": "view:cost_price",
        "removeCompleting": "create:sales+confirm:finance_disbursement"
      }
    },
    {
      "actor": {
        "role": "internal",
        "org": "A"
      },
      "action": "migrateRoles.backfillAccountantCostPriceAccess",
      "input": {
        "role": "ACCOUNTANT_OWNER_RESTRICTED",
        "run": "NEXT_DEPLOY"
      }
    },
    {
      "actor": {
        "role": "accountant",
        "org": "A"
      },
      "action": "vehicles.getAcquisitionCostCorrectionContext",
      "input": {
        "role": "ACCOUNTANT_OWNER_RESTRICTED"
      }
    }
  ],
  "expected": [
    {
      "observable": "firstRun.updatedCount",
      "value": 1
    },
    {
      "observable": "ownerSave.accepted",
      "value": "true"
    },
    {
      "observable": "nextRun.updatedCount",
      "value": 0
    },
    {
      "observable": "role.storedPermissions",
      "value": "unchanged"
    },
    {
      "observable": "vehicles.get.purchasePrice",
      "value": "withheld"
    },
    {
      "observable": "correctionContext.refusal",
      "value": "FORBIDDEN-view:cost_price"
    }
  ],
  "rulings": [
