  "matrixRow": "SCRUM908-accountant-commission-visibility",
  "id": "accountant-commission-backfill-preserves-owner-choices",
  "steps": [
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.update",
      "input": {
        "role": "ACCOUNTANT",
        "rename": "RENAMED_ACCOUNTANT"
      }
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.create",
      "input": {
        "name": "ACCOUNTANT",
        "permissions": "CUSTOM_EXTRA_PERMISSION"
      }
    },
    {
      "actor": {
        "role": "internal",
        "org": "A"
      },
      "action": "migrateRoles.backfillAccountantCommissionsAccess",
      "input": {}
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.remove",
      "input": {
        "role": "RECREATED_ACCOUNTANT"
      }
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.update",
      "input": {
        "role": "RENAMED_ACCOUNTANT",
        "rename": "ACCOUNTANT"
      }
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.update",
      "input": {
        "role": "ACCOUNTANT",
        "permissions": "OWNER_RESTRICTED_CUSTOM_EXTRA"
      }
    },
    {
      "actor": {
        "role": "internal",
        "org": "A"
      },
      "action": "migrateRoles.backfillAccountantCommissionsAccess",
      "input": {
        "run": "NEXT_DEPLOY"
      }
    }
  ],
  "expected": [
    {
      "observable": "custom.grant",
      "value": false
    },
    {
      "observable": "ownerRestriction.overridden",
      "value": false
    }
  ],
  "impl": {
    "file": "convex/accountantCommissionsBackfill.scrum908.test.ts",
    "testName": "SCRUM-908: commission backfill respects an owner's public rename, recreation and later restriction"
  },
