{
  "id": "accountant-backfill-does-not-grant-a-renamed-or-recreated-custom-accountant",
  "domain": "permission",
  "level": "backend",
  "status": "active",
  "source": {
    "runId": "scrum896-round4",
    "hunter": "scripted",
    "firstSeen": "2026-11-02"
  },
  "steps": [
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.update",
      "input": {
        "role": "ACCOUNTANT_WITHOUT_COST_ACCESS",
        "rename": "OTHER_NAME"
      }
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.create",
      "input": {
        "name": "ACCOUNTANT",
        "permissions": "view:vehicles+view:finance+manage:finance"
      }
    },
    {
      "actor": {
        "role": "internal",
        "org": "A"
      },
      "action": "migrateRoles.backfillAccountantCostPriceAccess",
      "input": {
        "role": "CUSTOM_ACCOUNTANT_NO_COMPLETING"
      }
    },
    {
      "actor": {
        "role": "accountant",
        "org": "A"
      },
      "action": "vehicles.getAcquisitionCostCorrectionContext",
      "input": {
        "role": "CUSTOM_ACCOUNTANT_NO_COMPLETING"
      }
    }
  ],
  "expected": [
    {
      "observable": "backfill.updatedCount",
      "value": 0
    },
    {
      "observable": "customRole.storedPermissions",
      "value": "unchanged"
    },
    {
      "observable": "renamedRole.storedPermissions",
      "value": "unchanged"
    },
    {
      "observable": "vehicles.get.purchasePrice",
      "value": "withheld"
    },
    {
      "observable": "correctionContext.refusal",
      "value": "FORBIDDEN-view:cost_price"
    }
  ],
  "rulings": [
    {
