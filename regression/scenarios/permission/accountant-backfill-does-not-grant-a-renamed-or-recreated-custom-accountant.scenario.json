    }
  ],
  "impl": {
    "file": "convex/consignedSaleCostAccessRule.scrum886.test.ts",
    "testName": "an owner renames the seeded ACCOUNTANT, then creates a custom role named ACCOUNTANT without completing permissions: the backfill does not grant it and cost stays withheld"
  },
