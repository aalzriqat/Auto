      "observable": "update.accepted",
      "value": true
    },
    {
      "observable": "storedPermissions.viewCommissions",
      "value": false
    },
    {
      "observable": "storedPermissions.viewCostPrice",
      "value": true
    },
    {
      "observable": "storedPermissions.confirmDisbursement",
      "value": true
    }
  ],
