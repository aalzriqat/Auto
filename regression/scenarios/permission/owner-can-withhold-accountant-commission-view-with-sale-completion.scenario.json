  "id": "owner-can-withhold-accountant-commission-view-with-sale-completion",
  "steps": [
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "organizations.create",
      "input": {
        "templates": "DEFAULT"
      }
    },
    {
      "actor": {
        "role": "owner",
        "org": "A"
      },
      "action": "roles.update",
      "input": {
        "role": "ACCOUNTANT",
        "remove": "view:commissions",
        "retain": "view:cost_price+confirm:finance_disbursement"
      }
    }
  ],
  "expected": [
