  },
  "steps": [
    {
      "actor": {
        "role": "system",
        "org": "A"
      },
      "action": "database.enableTransactionLimits",
      "input": {
        "limitBytes": 16777216
      }
    },
    {
      "actor": {
        "role": "finance",
        "org": "A"
      },
      "action": "database.insertPayables",
      "input": {
        "count": 20,
        "paidJod": 9500,
        "status": "PAID",
        "paymentNotesChars": 900000
      }
    },
    {
      "actor": {
        "role": "finance",
        "org": "A"
      },
      "action": "database.openSupplierReceivable",
      "input": {
        "marginJod": 3000,
        "depositAppliedJod": 0,
        "currency": "JOD"
      }
    },
    {
      "actor": {
        "role": "finance",
        "org": "A"
      },
      "action": "supplierReceivables.recordReceipt",
      "input": {
        "amountJod": 500,
        "method": "CASH"
      }
    },
    {
      "actor": {
        "role": "finance",
        "org": "A"
      },
      "action": "supplierStatement.settled",
      "input": {
        "supplier": "S1"
      }
    }
  ],
  "expected": [
    {
      "observable": "payable.complete",
      "value": false
    },
    {
      "observable": "payable.incompleteReason",
      "value": "READ_BUDGET"
    },
    {
      "observable": "payable.totals",
      "value": "withheld"
    },
    {
      "observable": "receivable.complete",
      "value": false
    },
    {
      "observable": "receivable.incompleteReason",
      "value": "READ_BUDGET"
    },
    {
      "observable": "receivable.totals",
      "value": "withheld"
    }
  ],
