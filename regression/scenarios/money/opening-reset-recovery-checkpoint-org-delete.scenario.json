      "value": true
    },
    {
      "observable": "interleavedReset.refusedWithoutCheckpointRecreation",
      "value": true
    },
    {
      "observable": "deletion.dryRunPreserved",
      "value": true
    }
  ],
  "impl": {
    "file": "convex/adminOrgs.test.ts",
    "testName": "hard deletion prevents an interleaved reset from recreating a recovery checkpoint"
