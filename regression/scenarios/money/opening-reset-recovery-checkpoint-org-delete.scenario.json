    {
      "actor": {
        "role": "super-admin",
        "org": "A"
      },
      "action": "adminOrgs.hardDeleteOrg",
      "input": {
        "confirmedOrganizationName": true
      }
    },
    {
      "actor": {
        "role": "system",
        "org": "A"
      },
      "action": "orgFinancialReset.resetOrgFinancialData",
      "input": {
        "continuation": true,
        "batchSize": 1,
        "afterDeletionAdmission": true
      }
    },
    {
      "actor": {
        "role": "system",
        "org": "A"
      },
      "action": "adminOrgs.runDeletionRequestBatch",
      "input": {
        "naturalCursorProgressionUntilRecoveryDeleted": true
      }
    }
  ],
  "expected": [
