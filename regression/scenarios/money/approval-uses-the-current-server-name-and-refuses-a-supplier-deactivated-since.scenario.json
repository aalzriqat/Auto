{
  "id": "approval-uses-the-current-server-name-and-refuses-a-supplier-deactivated-since",
  "domain": "money",
  "level": "backend",
  "steps": [
    {
      "actor": {
        "role": "CLERK",
        "org": "A"
      },
      "action": "vehicleEdits.requestCreate",
      "input": {
        "payload": {
          "sourceType": "SOURCED",
          "sourceCost": 9000,
          "sourcedSupplierId": "SUPPLIER_ID"
        }
      }
    },
    {
      "actor": {
        "role": "OWNER",
        "org": "A"
      },
      "action": "suppliers.deactivate",
      "input": {
        "supplierId": "SUPPLIER_ID"
      }
    },
    {
      "actor": {
        "role": "OWNER",
        "org": "A"
      },
      "action": "vehicleEdits.resolve",
      "input": {
        "requestId": "REQUEST_ID",
        "status": "APPROVED"
      }
    },
    {
      "actor": {
        "role": "OWNER",
        "org": "A"
      },
      "action": "suppliers.reactivate",
      "input": {
        "supplierId": "SUPPLIER_ID"
      }
    },
    {
      "actor": {
        "role": "OWNER",
        "org": "A"
      },
      "action": "suppliers.update",
      "input": {
        "supplierId": "SUPPLIER_ID",
        "displayName": "RENAMED_DISPLAY_NAME"
      }
    },
    {
      "actor": {
        "role": "OWNER",
        "org": "A"
      },
      "action": "vehicleEdits.resolve",
      "input": {
        "requestId": "REQUEST_ID",
        "status": "APPROVED"
      }
    }
  ],
  "expected": [
    {
      "observable": "step3.refusal",
      "value": "SUPPLIER_INACTIVE"
    },
    {
      "observable": "step3.writes.rowCount",
      "value": 0
    },
    {
      "observable": "vehicle.sourcedSupplierId",
      "value": "SUPPLIER_ID"
    },
    {
      "observable": "vehicle.sourcedFromName",
      "value": "RENAMED_DISPLAY_NAME"
    }
  ],
